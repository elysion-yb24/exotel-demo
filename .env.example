# ---------------------------------------------------------------------------
# Set 1 — standard Exotel account (Dashboard > Settings > API Settings)
# Used for: provisioning, and the v1 Connect API if you bypass the CRM SDK.
# ---------------------------------------------------------------------------
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# api.in.exotel.com (Mumbai) or api.exotel.com (Singapore)
EXOTEL_SUBDOMAIN=api.in.exotel.com

# ---------------------------------------------------------------------------
# Set 2 — Integrations platform (icore). This is what the WebRTC flow needs.
# ---------------------------------------------------------------------------
EXOTEL_CUSTOMER_ID=
EXOTEL_CUSTOMER_SECRET=
EXOTEL_APP_ID=
EXOTEL_APP_SECRET=

# The AppUserId of the agent you want to test with.
EXOTEL_TEST_USER_ID=

# Virtual number (ExoPhone) shown to the customer as caller ID.
EXOTEL_CALLER_ID=

# A real mobile you can answer, for the end-to-end dial test. E.164 or 0-prefixed.
SMOKE_TEST_DIAL_TO=

PORT=8787
